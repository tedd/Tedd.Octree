<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0;net10.0;netstandard2.1</TargetFrameworks>
    <LangVersion Condition="'$(TargetFramework)' == 'net11.0'">preview</LangVersion>
    <LangVersion Condition="'$(TargetFramework)' != 'net11.0'">14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Version>2.0.0</Version>
    <PackageId>Tedd.Voxtree</PackageId>
    <Authors>Tedd Hansen</Authors>
    <Description>Compact span-backed voxel octrees with allocation-free queries, multi-channel chunks, and disk-backed global/LOD chunk streaming.</Description>
    <Copyright>Copyright © Tedd Hansen</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/tedd/Tedd.Voxtree</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tedd/Tedd.Voxtree</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>octree;voxel;span;zero-allocation;performance;streaming;lod;zstandard</PackageTags>
    <PackageReleaseNotes>Version 2 introduces span-backed builds/queries, Morton hot chunks, multi-channel chunks, automatic disk persistence, compressed LRU residency, caller-generated LOD layers, and bounded or effectively unbounded streamed worlds. Targets .NET 11 preview, .NET 10, and .NET Standard 2.1.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tedd.MortonEncoding" Version="1.0.1" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="" />
    <None Include="..\..\docs\BULK_STREAMING.md" Pack="true" PackagePath="docs/" />
  </ItemGroup>

</Project>
